---
import Layout from './Layout.astro';

interface Props {
  title: string;
  age: string;
  duration: string;
  programCode: string;
  logo: ImageMetadata;
  applicationFormLink?: string;
}

const { title, age, duration, programCode, logo, applicationFormLink } = Astro.props;

const metadata = {
  title: `${programCode} (${title} de ${duration})`,
  description: `Intercambios de Rotary en Centroamérica para jóvenes (${age} años)`,
};

const formUrl = applicationFormLink ?? `/programas/${programCode.toLowerCase()}/aplicar`;
const printablePageUrl = Astro.url.toString();
const printableQrUrl = `https://quickchart.io/qr?size=180&margin=1&text=${encodeURIComponent(printablePageUrl)}`;
---

<Layout metadata={metadata}>
  <!-- 1. Hero del programa -->
  <section class="py-20 program-print-hero">
    <div class="container-custom">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="flex flex-col gap-6">
          <div class="program-print-title-row">
            <div class="program-print-title-copy">
              <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
                {title}
              </h1>
              <p class="program-print-hero-url">
                {printablePageUrl}
              </p>
              <div class="flex flex-wrap gap-4 my-6 text-gray-600 dark:text-white program-print-badges">
                <span class="badge bg-primary-100 dark:bg-secondary-500 px-3">
                  Edad: {age} años
                </span>
                <span class="badge bg-primary-100 dark:bg-secondary-500 px-3">
                  Duración: {duration}
                </span>
              </div>
            </div>
            <div class="program-print-qr">
              <img src={printableQrUrl} alt={`QR para ${printablePageUrl}`} class="program-print-qr-image" />
            </div>
          </div>
          <a href="#aplicar" class="btn btn-primary mt-6 w-fit program-print-hero-action">Quiero participar</a>
        </div>
        <div class="flex justify-center">
          <div class="w-64 h-64 overflow-hidden program-print-hero-logo">
            <img
                src={logo.src}
                alt={`Logo de ${title}`}
                class="w-full h-full object-contain p-4"
              />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contenido principal -->
  <slot />

  <!-- Call to Action Final -->
  <section id="aplicar" class="py-20 bg-primary-50 dark:bg-primary-900/10 program-print-cta">
    <div class="container-custom text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-8">
        ¿Listo para vivir esta experiencia?
      </h2>
      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href={formUrl}
          target={applicationFormLink ? '_blank' : '_self'}
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          Aplica Hoy Mismo
        </a>
        <a href="/contacto" class="btn btn-outline-primary">¿Tienes preguntas?</a>
        <a href="/#programas" class="btn btn-outline-secondary">Ver otros programas</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .program-print-qr {
    display: none;
  }

  .program-print-hero-url {
    display: none;
  }

  @media print {
    :global(header .container-custom > :not(a[aria-label="Ir a la página principal"])) {
      display: none !important;
    }

    :global(header) {
      position: static !important;
      backdrop-filter: none !important;
      background: #fff !important;
      border-bottom: 0 !important;
    }

    :global(header .container-custom) {
      justify-content: center !important;
    }

    :global(header a[aria-label="Ir a la página principal"]) {
      display: flex !important;
      justify-content: center !important;
      width: 100% !important;
    }

    :global(header a[aria-label="Ir a la página principal"] > *) {
      width: 28rem !important;
      max-width: none !important;
      margin-right: 0 !important;
      margin-left: 0 !important;
    }

    :global(footer) {
      display: none !important;
    }

    .program-print-hero {
      break-after: page;
      page-break-after: always;
    }

    .program-print-hero-action {
      display: none !important;
    }

    .program-print-qr {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-left: auto;
    }

    .program-print-qr-image {
      width: 88px;
      height: 88px;
      object-fit: contain;
    }

    .program-print-hero-logo {
      width: 22rem !important;
      height: 22rem !important;
    }

    .program-print-title-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
    }

    .program-print-title-row h1 {
      margin-bottom: 0 !important;
    }

    .program-print-title-copy {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .program-print-badges {
      margin-top: 0.5rem !important;
      margin-bottom: 0 !important;
    }

    .program-print-hero-url {
      display: block;
      margin: 0;
      font-size: 0.75rem;
      color: #374151;
      max-width: 24rem;
      word-break: break-all;
    }

    .program-print-cta {
      display: none !important;
    }
  }
</style>